define function !!TRDesNWExport(!FileNameWithPath is string, !ScopeElements is array, !AttOrRvmOrBoth is STRING, !InsuColour is REAL, !InsuTranslucency is REAL) 

  !TRDesNWExporter                                    = object TRDesNWExporter()

  !TRDesNWExporter.AttFileName                        = !FileNameWithPath + |.att|
  !TRDesNWExporter.RVMFileName                        = !FileNameWithPath + |.rvm|

  !TRDesNWExporter.SetupInputFiles()
  !TRDesNWExporter.SetupNWRepr()
  
  !TRDesNWExporter.TRDesReviewSettings.NWScopeData    = !ScopeElements
  !TRDesNWExporter.TRDesReviewSettings.NWAttScopeData = !ScopeElements

  if !AttOrRvmOrBoth.upcase().eq(|ATT|)  then
    !TRDesNWExporter.dumpAtts()
  elseif !AttOrRvmOrBoth.upcase().eq(|RVM|) then
    !TRDesNWExporter.ExportNWScope()
  elseif !AttOrRvmOrBoth.upcase().eq(|INSU|) then
    !TRDesNWExporter.InsuColour                       = !InsuColour
    !TRDesNWExporter.InsuTranslucency                 = !InsuTranslucency
    !TRDesNWExporter.SetupNWInsuRepr()
    !TRDesNWExporter.ExportNWInsuScope()
  elseif !AttOrRvmOrBoth.upcase().eq(|ALL|) then
    !TRDesNWExporter.ExportNWScope()
    !TRDesNWExporter.dumpAtts()
    !TRDesNWExporter.InsuColour                       = !InsuColour
    !TRDesNWExporter.InsuTranslucency                 = !InsuTranslucency
    !TRDesNWExporter.SetupNWInsuRepr()
    !TRDesNWExporter.ExportNWInsuScope()
  endif

endfunction